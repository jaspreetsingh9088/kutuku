{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix admin",
  "buildCommand": "npm run build --prefix admin",
  "outputDirectory": "admin/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{backend/database/**,backend/static/**,node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/privacy", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/v1/cron/sweep", "schedule": "0 3 * * *" }
  ]
}
